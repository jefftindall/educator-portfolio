{
  "routes": [
    {
      "route": "/standards-and-leadership*",
      "redirect": "/leadership-and-impact",
      "statusCode": 301
    },
    {
      "route": "/teaching-philosophy*",
      "redirect": "/about",
      "statusCode": 301
    },
    {
      "route": "/dance-for-every-body*",
      "redirect": "/leadership-and-impact/dance-for-every-body",
      "statusCode": 301
    },
    {
      "route": "/_astro/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/media/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/api/*",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cache-Control": "public, must-revalidate, max-age=30"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
