---
import BaseLayout from '../layouts/BaseLayout.astro';
import BadgeList from '../components/BadgeList.astro';
import { buildPersonJsonLd } from '../lib/personSchema';
import {
  credibilityBadges,
  heroHeadline,
  heroSubhead,
  positioningParagraph,
} from '../lib/content/credentials';
const jsonLd = buildPersonJsonLd();
---

<BaseLayout
  title="Home"
  description={positioningParagraph}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="border-b border-gray-200 bg-gradient-to-b from-accent-50/90 to-white">
    <div class="mx-auto max-w-4xl px-6 py-14 text-center md:py-20">
      <p class="text-sm font-medium uppercase tracking-wide text-accent-700">Dance educator · Ed.S.</p>
      <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight text-gray-900 md:text-5xl">
        {heroHeadline}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-gray-700">{heroSubhead}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/teaching-philosophy"
          class="inline-flex min-h-11 items-center rounded-lg bg-accent-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-accent-700"
        >
          Read my teaching philosophy
        </a>
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 transition hover:border-accent-200 hover:bg-accent-50"
        >
          CV & contact
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <p class="text-lg leading-relaxed text-gray-700">{positioningParagraph}</p>
    <div class="mt-10">
      <BadgeList items={credibilityBadges} />
    </div>
    <p class="mt-10 text-center text-sm text-gray-600">
      Since 2024, I have been part of the Connected Arts Network’s national professional learning
      community.
    </p>
  </section>

  <section class="border-t border-gray-200 bg-gray-50">
    <div class="mx-auto max-w-4xl px-6 py-12 md:py-14">
      <h2 class="text-center text-xl font-semibold text-gray-900">Explore</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2" role="list">
        <li>
          <a
            href="/standards-and-leadership"
            class="block rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-accent-200 hover:shadow-md"
          >
            <span class="font-medium text-gray-900">Standards & leadership</span>
            <span class="mt-1 block text-sm text-gray-600"
              >Georgia standards writing, NCAS artistic processes, assessment</span
            >
          </a>
        </li>
        <li>
          <a
            href="/dance-for-every-body"
            class="block rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-accent-200 hover:shadow-md"
          >
            <span class="font-medium text-gray-900">Dance for Every Body</span>
            <span class="mt-1 block text-sm text-gray-600"
              >Inclusive practice, NDEO 2025, classroom stories</span
            >
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
