---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import Figure from '../../components/Figure.astro';
import VideoFigure from '../../components/VideoFigure.astro';
import Icon from '../../components/Icon.astro';
import barreClass from '../../assets/photos/barre-class.jpg';
import ensembleWhite from '../../assets/photos/stage-ensemble-white.jpg';
import fieldTrip from '../../assets/photos/field-trip-performance.jpg';
import classInStudio from '../../assets/photos/inclusive-class-studio.jpg';
import { departmentLeadership, programPoints } from '../../lib/content/program';
import { ndeoSessionDescription } from '../../lib/content/inclusive';
import {
  artisticProcesses,
  assessmentPhilosophy,
  standardsWriting,
  technologyStatement,
  whyServe,
} from '../../lib/content/standards';
---

<BaseLayout
  title="Leadership and impact"
  description="Fine arts department leadership, Georgia dance standards writing, an open-enrollment dance program aligned to the NCAS artistic processes, and inclusive dance for every student."
  canonicalPath="/leadership-and-impact"
>
  <PageHeader
    title="Leadership and impact"
    lede="Standards written from the classroom up, a dance program open to every student, and a fine arts department that serves all four arts."
  />

  <Prose>
    <h2 class="pt-0!">Leading a fine arts department</h2>
    <p class="leading-relaxed">{departmentLeadership}</p>

    <h2>Standards-writing experience</h2>
    <p class="leading-relaxed">{standardsWriting}</p>

    <h2>Building the dance program</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        programPoints.map((point) => (
          <article class="rounded-brand border border-soft-stone bg-white p-5">
            <h3>{point.title}</h3>
            <p class="mt-2 leading-relaxed">{point.body}</p>
          </article>
        ))
      }
    </div>

    <h2>Artistic processes in my classroom</h2>
    <p>Aligned to the National Core Arts Standards anchor processes.</p>
    <div class="overflow-x-auto rounded-brand border border-soft-stone bg-white">
      <table class="w-full min-w-[32rem] border-collapse text-left text-base">
        <thead class="surface-dark">
          <tr>
            <th class="label px-4 py-3">Process</th>
            <th class="label px-4 py-3">In class</th>
            <th class="label px-4 py-3">Evidence</th>
          </tr>
        </thead>
        <tbody>
          {
            artisticProcesses.map((row) => (
              <tr class="align-top even:bg-soft-stone/60">
                <td class="px-4 py-3 font-bold text-midnight">{row.process}</td>
                <td class="px-4 py-3">{row.classroom}</td>
                <td class="px-4 py-3">{row.artifact}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <VideoFigure
      src="/media/video/student-choreography.mp4"
      poster="/media/video/student-choreography-poster.jpg"
      title="Students performing choreography they created as a class"
      caption="Creating: one of my classes performs the choreography they built together."
    />

    <ul class="grid gap-4 sm:grid-cols-3" role="list">
      <li>
        <Figure
          src={barreClass}
          alt="A full dance class works at portable ballet barres across the studio."
          caption="Daily technique at the barre."
          sizes="(min-width: 768px) 15rem, (min-width: 640px) 33vw, 100vw"
        />
      </li>
      <li>
        <Figure
          src={ensembleWhite}
          alt="An ensemble in white shirts crouches low in a line across a blue-lit stage."
          caption="Performing on the concert stage."
          sizes="(min-width: 768px) 15rem, (min-width: 640px) 33vw, 100vw"
        />
      </li>
      <li>
        <Figure
          src={fieldTrip}
          alt="Students and staff smile from their seats in a historic theater before a show."
          caption="Responding: seeing professional dance live."
          sizes="(min-width: 768px) 15rem, (min-width: 640px) 33vw, 100vw"
        />
      </li>
    </ul>

    <h2>Dance for every body</h2>
    <div class="grid items-start gap-6 rounded-brand border border-soft-stone bg-white p-6 sm:grid-cols-[1fr_12rem]">
      <div class="space-y-4">
        <p class="leading-relaxed">{ndeoSessionDescription}</p>
        <p>
          <a href="/leadership-and-impact/dance-for-every-body" class="btn-primary">
            Read about inclusive dance
            <Icon name="arrow-right" class="h-5 w-5" />
          </a>
        </p>
      </div>
      <Figure
        src={classInStudio}
        alt="A large inclusive dance class strikes a pose together in the studio, including a student in a wheelchair."
        sizes="(min-width: 640px) 12rem, 100vw"
        class="max-w-[12rem]"
      />
    </div>

    <h2>Assessment philosophy</h2>
    <p class="leading-relaxed">{assessmentPhilosophy}</p>

    <h2>Technology & artistic literacy</h2>
    <p class="leading-relaxed">{technologyStatement}</p>

    <h2>Commitment to service</h2>
    <p class="leading-relaxed">{whyServe}</p>
  </Prose>
</BaseLayout>
