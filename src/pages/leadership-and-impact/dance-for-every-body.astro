---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import Figure from '../../components/Figure.astro';
import VideoFigure from '../../components/VideoFigure.astro';
import Icon from '../../components/Icon.astro';
import classOnStage from '../../assets/photos/inclusive-class-stage.jpg';
import classInStudio from '../../assets/photos/inclusive-class-studio.jpg';
import ndeoPhoto from '../../assets/photos/ndeo-2025.jpg';
import officeWithStudent from '../../assets/photos/office-with-student.jpg';
import {
  inclusiveBenefits,
  inclusiveStrategies,
  learningLadderRungs,
  ndeoSessionDescription,
  ndeoSessionTitle,
  presentationPdf,
} from '../../lib/content/inclusive';
---

<BaseLayout
  title="Dance for Every Body"
  description="Inclusive dance practice: NDEO 2025 session, three strategies, and the Dance I etiquette learning ladder."
  canonicalPath="/leadership-and-impact/dance-for-every-body"
>
  <PageHeader label="Leadership and impact" title="Dance for Every Body" lede={ndeoSessionDescription} />

  <Prose>
    <Figure
      src={classOnStage}
      alt="Four students in bright costumes dance on stage, two with fists raised high and two turning toward each other."
      caption="Performing together on the concert stage."
      loading="eager"
    />

    <h2>NDEO 2025 national conference</h2>
    <div class="grid items-start gap-6 sm:grid-cols-[1fr_12rem]">
      <div class="space-y-4">
        <p class="font-serif text-[22px] italic text-midnight">{ndeoSessionTitle}</p>
        <p class="leading-relaxed">
          Disability and Pedagogy track · October 2025. Inclusive Dance I brings general and special education
          students together to learn the same standards and perform each semester - including Karina’s Class,
          which began at Steps of Faith Dance Studio and continues at Woodland High School with principal
          support.
        </p>
      </div>
      <Figure
        src={ndeoPhoto}
        alt="Tiffany smiling with one hand on her hip in front of the National Dance Education Organization banner."
        caption="At the NDEO national conference."
        widths={[400, 800]}
        sizes="(min-width: 640px) 12rem, 100vw"
        imgClass="aspect-[4/5] object-cover object-top"
        class="max-w-[12rem]"
      />
    </div>

    <h2>Three strategies</h2>
    <div class="space-y-8">
      {
        inclusiveStrategies.map((strategy) => (
          <article>
            <h3>{strategy.title}</h3>
            <p class="mt-2 leading-relaxed">{strategy.body}</p>
          </article>
        ))
      }
    </div>

    <VideoFigure
      src="/media/video/clapping-dance.mp4"
      poster="/media/video/clapping-dance-poster.jpg"
      title="The clapping dance from Eric's story, performed on stage"
      caption="The clapping dance from Eric’s story, on stage with his classmates."
    />

    <h2>Dance I etiquette learning ladder</h2>
    <p class="leading-relaxed">
      Concrete rungs turn expectations into steps students can master - shared with classroom teachers when
      goals overlap.
    </p>
    <ol class="list-decimal space-y-2 pl-5">
      {
        learningLadderRungs.map((rung) => (
          <li>{rung}</li>
        ))
      }
    </ol>

    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      <li>
        <Figure
          src={classInStudio}
          alt="A large inclusive dance class strikes a pose together in the studio, including a student in a wheelchair."
          caption="One class, every ability."
          sizes="(min-width: 768px) 24rem, (min-width: 640px) 50vw, 100vw"
        />
      </li>
      <li>
        <Figure
          src={officeWithStudent}
          alt="A student in a wheelchair points dramatically with both arms while Tiffany, seated behind her at the desk, strikes the same pose."
          caption="Between classes in my office."
          sizes="(min-width: 768px) 24rem, (min-width: 640px) 50vw, 100vw"
        />
      </li>
    </ul>

    <h2>Who benefits</h2>
    <dl class="space-y-4">
      <div>
        <dt class="font-bold text-midnight">Students with disabilities</dt>
        <dd class="mt-1">{inclusiveBenefits.studentsWithDisabilities}</dd>
      </div>
      <div>
        <dt class="font-bold text-midnight">General education students</dt>
        <dd class="mt-1">{inclusiveBenefits.generalEducationStudents}</dd>
      </div>
      <div>
        <dt class="font-bold text-midnight">Dance teachers</dt>
        <dd class="mt-1">{inclusiveBenefits.teachers}</dd>
      </div>
      <div>
        <dt class="font-bold text-midnight">Special education staff</dt>
        <dd class="mt-1">{inclusiveBenefits.specialEducationStaff}</dd>
      </div>
    </dl>

    <h2>More stories</h2>
    <ul class="list-disc space-y-2 pl-5">
      <li>
        John preferred bright lights and loud music - a reminder to observe before assuming what a label
        means for stimulation.
      </li>
      <li>
        Kyler, a non-verbal student in Karina’s Class, responded to basic ASL cues (Stop, Go, Dance, Sit,
        More, Done) and began seeking connection in class.
      </li>
      <li>
        Molly could not jump at age eight; years of consistent practice brought two-foot jumps and grand
        battements across the floor.
      </li>
      <li>
        Paige uses a wheelchair; occupational therapy partners and I design core-strength work inside dance
        class.
      </li>
    </ul>

    <h2>Use the presentation</h2>
    <div class="rounded-brand border border-soft-stone bg-white p-6">
      <p>
        The slides from my NDEO 2025 session are free to view, share, and adapt for your own classes and
        professional learning.
      </p>
      <p class="mt-5">
        <a href={presentationPdf} download class="btn-primary">
          <Icon name="download" class="h-5 w-5" />
          Download the slides (PDF, 5.3 MB)
        </a>
      </p>
    </div>
  </Prose>
</BaseLayout>
