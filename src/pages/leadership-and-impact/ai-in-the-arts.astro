---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyPrompt from '../../components/CopyPrompt.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import {
  aiPageLede,
  aiPageTitle,
  artForms,
  assistantPlatformsNote,
  buildAnAssistantSteps,
  departmentIdeas,
  ideasIntro,
  myUses,
  responsibleUse,
} from '../../lib/content/ai';
---

<BaseLayout
  title={aiPageTitle}
  description="How an arts education leader uses AI for show collateral, leveled lessons, and grants, with prompts and reusable assistants for dance, theatre, music, and visual art teachers."
  canonicalPath="/leadership-and-impact/ai-in-the-arts"
>
  <PageHeader label="Leadership and impact" title={aiPageTitle} lede={aiPageLede} />

  <Prose>
    <h2 class="pt-0!">How I use AI</h2>
    <div class="space-y-8">
      {
        myUses.map((use) => (
          <article>
            <h3>{use.title}</h3>
            <p class="mt-2 leading-relaxed">{use.body}</p>
            <CopyPrompt label="Try this prompt" prompt={use.prompt} />
          </article>
        ))
      }
    </div>

    <aside
      aria-labelledby="responsible-use"
      class="rounded-brand border-l-4 border-studio bg-soft-stone/40 px-5 py-4 text-base"
    >
      <p id="responsible-use" class="label text-midnight">Use AI responsibly</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        {responsibleUse.map((rule) => <li class="leading-relaxed">{rule}</li>)}
      </ul>
    </aside>

    <h2>Ideas to try, by art form</h2>
    <p class="leading-relaxed">{ideasIntro}</p>

    <div data-art-tabs class="group space-y-6">
      <div
        role="tablist"
        aria-label="Art forms"
        class="hidden overflow-x-auto overflow-y-hidden shadow-[inset_0_-1px_0_var(--color-soft-stone)] group-data-ready:flex"
      >
        {
          artForms.map((art, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${art.id}`}
              aria-controls={`panel-${art.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-art-id={art.id}
              class="min-h-11 shrink-0 focus-visible:-outline-offset-4 border-b-4 border-transparent px-4 font-semibold whitespace-nowrap text-charcoal hover:text-midnight aria-selected:border-studio aria-selected:text-midnight"
            >
              {art.name}
            </button>
          ))
        }
      </div>

      {
        artForms.map((art) => (
          <section id={`panel-${art.id}`} class="space-y-6" aria-labelledby={art.id}>
            <h2 id={art.id} class="scroll-mt-24 group-data-ready:sr-only group-data-ready:scroll-mt-48">{art.name}</h2>
            <p class="leading-relaxed">{art.intro}</p>
            <div class="space-y-8">
              {art.ideas.map((idea) => (
                <article>
                  <h3>{idea.title}</h3>
                  <p class="mt-2 leading-relaxed">{idea.body}</p>
                  <CopyPrompt label="Prompt" prompt={idea.prompt} />
                </article>
              ))}
            </div>
            <article class="surface-dark rounded-brand p-6">
              <p class="label">Build this assistant</p>
              <h3 class="mt-2">{art.assistant.name}</h3>
              <p class="mt-2 leading-relaxed">{art.assistant.purpose}</p>
              <p class="mt-4 font-bold">Instructions to paste</p>
              <p class="mt-1 leading-relaxed">{art.assistant.instructions}</p>
            </article>
          </section>
        ))
      }
    </div>

    <h2 id="department" class="scroll-mt-24">For department leads</h2>
    <p class="leading-relaxed">Ideas that serve all four arts at once.</p>
    <div class="space-y-8">
      {
        departmentIdeas.map((idea) => (
          <article>
            <h3>{idea.title}</h3>
            <p class="mt-2 leading-relaxed">{idea.body}</p>
            <CopyPrompt label="Prompt" prompt={idea.prompt} />
          </article>
        ))
      }
    </div>

    <h2 id="build-an-assistant" class="scroll-mt-24">Build your own assistant</h2>
    <p class="leading-relaxed">
      An assistant is a saved set of instructions you set up once and reuse. {assistantPlatformsNote}
    </p>
    <ol class="list-decimal space-y-2 pl-5">
      {buildAnAssistantSteps.map((step) => <li class="leading-relaxed">{step}</li>)}
    </ol>
  </Prose>
</BaseLayout>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-art-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''));
    if (tabs.length === 0 || panels.some((panel) => !panel)) continue;

    const select = (index: number, { focus = false, updateHash = false } = {}) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i]!.hidden = !selected;
      });
      if (focus) tabs[index].focus();
      if (updateHash) history.replaceState(null, '', `#${tabs[index].dataset.artId}`);
    };

    const indexForHash = () => tabs.findIndex((tab) => `#${tab.dataset.artId}` === location.hash);

    panels.forEach((panel, i) => {
      panel!.setAttribute('role', 'tabpanel');
      panel!.setAttribute('aria-labelledby', tabs[i].id);
      panel!.tabIndex = 0;
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, { updateHash: true }));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
          : event.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
          : event.key === 'Home' ? 0
          : event.key === 'End' ? last
          : -1;
        if (next === -1) return;
        event.preventDefault();
        select(next, { focus: true, updateHash: true });
      });
    });

    window.addEventListener('hashchange', () => {
      const index = indexForHash();
      if (index !== -1) select(index);
    });

    const initial = indexForHash();
    select(initial === -1 ? 0 : initial);
    root.dataset.ready = '';
  }
</script>
