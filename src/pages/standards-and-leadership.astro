---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import Figure from '../components/Figure.astro';
import VideoFigure from '../components/VideoFigure.astro';
import barreClass from '../assets/photos/barre-class.jpg';
import ensembleWhite from '../assets/photos/stage-ensemble-white.jpg';
import fieldTrip from '../assets/photos/field-trip-performance.jpg';
import {
  artisticProcesses,
  assessmentPhilosophy,
  standardsWriting,
  technologyStatement,
  whyServe,
} from '../lib/content/standards';
---

<BaseLayout
  title="Standards & leadership"
  description="Georgia dance standards writing, classroom alignment with NCAS artistic processes, and leadership in standards-based dance education."
  canonicalPath="/standards-and-leadership"
>
  <PageHeader
    title="Standards & leadership"
    lede="Standards written from the classroom up - and taught every day in an inclusive high-school dance program."
  />

  <Prose>
    <h2>Standards-writing experience</h2>
    <p class="leading-relaxed">{standardsWriting}</p>

    <h2>Artistic processes in my classroom</h2>
    <p>Aligned to the National Core Arts Standards anchor processes.</p>
    <div class="overflow-x-auto rounded-brand border border-soft-stone bg-white">
      <table class="w-full min-w-[32rem] border-collapse text-left text-base">
        <thead class="surface-dark">
          <tr>
            <th class="label px-4 py-3">Process</th>
            <th class="label px-4 py-3">In class</th>
            <th class="label px-4 py-3">Evidence</th>
          </tr>
        </thead>
        <tbody>
          {
            artisticProcesses.map((row) => (
              <tr class="align-top even:bg-soft-stone/60">
                <td class="px-4 py-3 font-bold text-midnight">{row.process}</td>
                <td class="px-4 py-3">{row.classroom}</td>
                <td class="px-4 py-3">{row.artifact}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <VideoFigure
      src="/media/video/student-choreography.mp4"
      poster="/media/video/student-choreography-poster.jpg"
      title="Students performing choreography they created as a class"
      caption="Creating: one of my classes performs the choreography they built together."
    />

    <ul class="grid gap-4 sm:grid-cols-3" role="list">
      <li>
        <Figure
          src={barreClass}
          alt="A full dance class works at portable ballet barres across the studio."
          caption="Daily technique at the barre."
          sizes="(min-width: 768px) 15rem, (min-width: 640px) 33vw, 100vw"
        />
      </li>
      <li>
        <Figure
          src={ensembleWhite}
          alt="An ensemble in white shirts crouches low in a line across a blue-lit stage."
          caption="Performing on the concert stage."
          sizes="(min-width: 768px) 15rem, (min-width: 640px) 33vw, 100vw"
        />
      </li>
      <li>
        <Figure
          src={fieldTrip}
          alt="Students and staff smile from their seats in a historic theater before a show."
          caption="Responding: seeing professional dance live."
          sizes="(min-width: 768px) 15rem, (min-width: 640px) 33vw, 100vw"
        />
      </li>
    </ul>

    <h2>Assessment philosophy</h2>
    <p class="leading-relaxed">{assessmentPhilosophy}</p>

    <h2>Technology & artistic literacy</h2>
    <p class="leading-relaxed">{technologyStatement}</p>

    <h2>Commitment to service</h2>
    <p class="leading-relaxed">{whyServe}</p>
  </Prose>
</BaseLayout>
