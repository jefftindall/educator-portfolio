---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import CvList from '../components/CvList.astro';
import Icon from '../components/Icon.astro';
import { communityService, standardsAndService, teachingHonors } from '../lib/content/recognition';
---

<BaseLayout
  title="Recognition"
  description="Teacher of the Year honors, Georgia dance standards writing, national service, and community leadership for Tiffany Tindall."
  canonicalPath="/recognition"
>
  <PageHeader
    title="Recognition"
    lede="Honors from my school and district, and the committees, networks, and boards I serve."
  />

  <Prose>
    <h2 class="pt-0!">Teacher of the Year</h2>
    <CvList items={teachingHonors} />

    <h2>Standards and national service</h2>
    <CvList items={standardsAndService} />

    <h2>Community leadership</h2>
    <CvList items={communityService} />

    <p class="pt-4">
      <a href="/contact" class="btn-primary">
        See my full CV
        <Icon name="arrow-right" class="h-5 w-5" />
      </a>
    </p>
  </Prose>
</BaseLayout>
