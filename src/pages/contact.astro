---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="How to reach Tiffany Tindall, Dance Teacher and Fine Arts Department Lead at Woodland High School."
  canonicalPath="/contact"
>
  <PageHeader
    title="Contact"
    lede="I’d love to hear from you about arts education, standards work, or a session for your teachers."
  />

  <Prose>
    <p class="flex flex-wrap items-center gap-3">
      <a href={`mailto:${site.email}`} class="btn-primary">
        <Icon name="mail" />
        Email me
      </a>
      <a href={site.linkedin} class="btn-secondary" rel="me noopener" target="_blank">
        <Icon name="linkedin" />
        Connect on LinkedIn
      </a>
    </p>
    <p>Looking for my background first? <a href="/experience">See my experience and honors</a>.</p>
  </Prose>
</BaseLayout>
