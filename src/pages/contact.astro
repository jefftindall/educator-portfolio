---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="CV & contact"
  description="Contact Tiffany Tindall, Ed.S., dance educator and fine arts leader at Woodland High School."
  canonicalPath="/contact"
  hideFooterCta={false}
>
  <PageHeader
    title="CV & contact"
    lede="Résumé highlights for standards review and professional inquiries. No home address or personal cell — email is the best channel."
  />

  <Prose>
    <h2 class="text-xl font-semibold text-gray-900">Contact</h2>
    <p>
      <a
        href={`mailto:${site.email}`}
        class="font-medium text-accent-700 underline-offset-2 hover:underline"
      >
        Email Tiffany
      </a>
    </p>

    <h2 class="text-xl font-semibold text-gray-900">Education & certification</h2>
    <ul class="list-disc space-y-2 pl-5">
      <li>Ed.S., Educational Administration — Jacksonville State University</li>
      <li>M.Ed., Educational Administration — Jacksonville State University</li>
      <li>P–12 Leadership certification</li>
    </ul>

    <h2 class="text-xl font-semibold text-gray-900">Current roles (2020–present)</h2>
    <ul class="list-disc space-y-2 pl-5">
      <li>Dance Director, Woodland High School</li>
      <li>Fine Arts Department Lead</li>
      <li>Performing Arts Center Director</li>
    </ul>

    <h2 class="text-xl font-semibold text-gray-900">Selected highlights</h2>
    <ul class="list-disc space-y-2 pl-5">
      <li>Georgia Department of Education Performance Standards Writing Committee for Dance Education (2008)</li>
      <li>Connected Arts Network Teacher Participant (NDEO), 2024–present</li>
      <li>NDEO National Conference presenter, 2025 — Dance for Every Body</li>
      <li>$5,000 Georgia Council for the Arts grant — school-wide fine arts musical</li>
      <li>Reinhardt University adjunct; NDEO member since 2003</li>
      <li>Community: Red Door Food Pantry leadership; Etowah Scholarship Foundation board</li>
    </ul>

    <p class="text-sm text-gray-600">
      A downloadable PDF résumé can be added when ready. For NCAS application materials, use this site URL
      and email for follow-up.
    </p>
  </Prose>
</BaseLayout>
