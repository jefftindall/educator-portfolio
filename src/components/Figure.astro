---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  caption,
  widths = [400, 800, 1200],
  sizes = '(min-width: 768px) 48rem, 100vw',
  class: className = '',
  imgClass = 'aspect-[4/3] object-cover',
  loading = 'lazy',
} = Astro.props;
const usableWidths = widths.filter((w) => w <= src.width);
---

<figure class={className}>
  <Image
    src={src}
    alt={alt}
    widths={usableWidths.length > 0 ? usableWidths : [src.width]}
    sizes={sizes}
    loading={loading}
    class:list={['h-auto w-full rounded-xl bg-gray-100', imgClass]}
  />
  {caption && <figcaption class="pt-2 text-sm text-gray-600">{caption}</figcaption>}
</figure>
