---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { nav } from '../lib/site';
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<header class="surface-dark sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
    <a href="/" class="no-underline" aria-label="Tiffany Tindall, home">
      <Wordmark variant="reversed" />
    </a>
    {
      nav.length > 0 && (
        <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
          {nav.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'text-base underline-offset-8 transition',
                  active ? 'font-semibold underline decoration-2' : 'no-underline hover:underline',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      )
    }
    {
      nav.length > 0 && (
        <details class="group relative md:hidden">
          <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-brand border border-ivory/40 px-3 [&::-webkit-details-marker]:hidden">
            <Icon name="menu" class="h-6 w-6 group-open:hidden" />
            <Icon name="x" class="hidden h-6 w-6 group-open:block" />
            <span class="text-base font-semibold">Menu</span>
          </summary>
          <div class="absolute right-0 mt-2 w-60 rounded-brand border border-ivory/20 bg-midnight p-2">
            {nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block min-h-11 rounded-brand px-3 py-2 text-base no-underline hover:underline',
                  isActive(item.href) && 'font-semibold underline',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        </details>
      )
    }
  </div>
</header>
