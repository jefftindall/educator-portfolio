---
interface Props {
  src: string;
  poster: string;
  title: string;
  caption?: string;
  class?: string;
}
const { src, poster, title, caption, class: className = '' } = Astro.props;
---

<figure class={className}>
  <video
    class="aspect-video w-full rounded-brand bg-midnight object-cover"
    src={src}
    poster={poster}
    controls
    playsinline
    preload="none"
    aria-label={title}
  ></video>
  {caption && <figcaption class="pt-2 text-base">{caption}</figcaption>}
</figure>
