---
import Icon from './Icon.astro';

interface Props {
  src: string;
  poster: string;
  label: string;
}
const { src, poster, label } = Astro.props;
---

<div class="hero-video relative overflow-hidden rounded-brand bg-midnight" data-hero-video>
  <video
    class="aspect-video w-full object-cover"
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    preload="metadata"
    aria-label={label}
  ></video>
  <button
    type="button"
    class="absolute right-3 bottom-3 inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-brand bg-midnight/70 px-3 font-semibold sm:px-4 text-ivory [--focus-ring:var(--color-spotlight)] transition hover:bg-midnight"
    data-hero-toggle
  >
    <Icon name="play" class="h-5 w-5" data-icon-play />
    <Icon name="pause" class="hidden h-5 w-5" data-icon-pause />
    <span class="sr-only sm:not-sr-only" data-hero-label>Play video</span>
  </button>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-video]')) {
    const video = root.querySelector('video');
    const toggle = root.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    if (!video || !toggle) continue;
    const playIcon = toggle.querySelector('[data-icon-play]');
    const pauseIcon = toggle.querySelector('[data-icon-pause]');
    const label = toggle.querySelector('[data-hero-label]');

    const sync = () => {
      const playing = !video.paused;
      if (label) label.textContent = playing ? 'Pause video' : 'Play video';
      playIcon?.classList.toggle('hidden', playing);
      pauseIcon?.classList.toggle('hidden', !playing);
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    toggle.addEventListener('click', () => {
      if (video.paused) void video.play();
      else video.pause();
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.play().catch(sync);
    }
    sync();
  }
</script>
