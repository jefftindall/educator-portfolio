---
import type { CvEntry } from '../lib/content/cv';

interface Props {
  items: readonly CvEntry[];
}
const { items } = Astro.props;
---

<ol class="divide-y divide-soft-stone border-y border-soft-stone" role="list">
  {
    items.map((item) => (
      <li class="py-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3>{item.title}</h3>
          <span class="text-base tabular-nums">{item.dates}</span>
        </div>
        <p class="text-base">
          {item.organization}
          {item.location && ` · ${item.location}`}
        </p>
        {item.details && <p class="mt-2">{item.details}</p>}
      </li>
    ))
  }
</ol>
