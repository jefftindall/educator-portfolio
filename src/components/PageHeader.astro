---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<section class="border-b border-gray-200 bg-gradient-to-b from-accent-50/80 to-white">
  <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <h1 class="text-3xl font-semibold tracking-tight text-gray-900 md:text-4xl">{title}</h1>
    {lede && <p class="mt-4 text-lg leading-relaxed text-gray-700">{lede}</p>}
  </div>
</section>
