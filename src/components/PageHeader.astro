---
import Arc from './Arc.astro';

interface Props {
  title: string;
  lede?: string;
  label?: string;
}
const { title, lede, label } = Astro.props;
---

<section class="relative overflow-hidden">
  <Arc
    class="pointer-events-none absolute -bottom-6 left-0 h-40 w-full text-soft-stone md:h-56"
    strokeWidth={28}
  />
  <div class="relative mx-auto max-w-[44rem] px-6 pt-14 pb-12 md:pt-20 md:pb-16">
    {label && <p class="label text-studio">{label}</p>}
    <h1 class:list={[label && 'mt-3']}>{title}</h1>
    {lede && <p class="mt-5 text-xl leading-relaxed">{lede}</p>}
  </div>
</section>
