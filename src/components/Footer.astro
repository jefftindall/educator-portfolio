---
import Icon from './Icon.astro';
import { site } from '../lib/site';

interface Props {
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;
---

<footer class="mt-16 border-t border-gray-200 md:mt-24">
  <div class="mx-auto max-w-6xl px-6 py-10 text-center text-sm text-gray-600">
    <p class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      {
        !hideCta && (
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-1.5 font-medium text-accent-700 underline-offset-2 hover:underline"
          >
            <Icon name="mail" />
            Email me
          </a>
        )
      }
      <a
        href={site.linkedin}
        class="inline-flex items-center gap-1.5 font-medium text-accent-700 underline-offset-2 hover:underline"
        rel="me noopener"
        target="_blank"
      >
        <Icon name="linkedin" />
        Connect on LinkedIn
      </a>
    </p>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
