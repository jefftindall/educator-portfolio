---
import { site } from '../lib/site';

interface Props {
  hideCta?: boolean;
}
const { hideCta: _hideCta = false } = Astro.props;
---

<footer class="mt-16 border-t border-gray-200 md:mt-24">
  <div class="mx-auto max-w-6xl px-6 py-10 text-center text-sm text-gray-600">
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
